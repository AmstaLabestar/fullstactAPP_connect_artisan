DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# CORS
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=https://your-frontend.com
# CSRF_TRUSTED_ORIGINS=https://your-frontend.com

# Database (PostgreSQL example)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=artisan_connect
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_CONN_MAX_AGE=60
# DB_SSLMODE=prefer

# JWT
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Upload limits
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# DRF throttle
DRF_THROTTLE_ANON=300/day
DRF_THROTTLE_USER=2000/day
DRF_THROTTLE_LOGIN=10/minute
DRF_THROTTLE_REGISTER=20/hour
DRF_THROTTLE_COMMENT=120/day
DRF_THROTTLE_LIKE=600/day
